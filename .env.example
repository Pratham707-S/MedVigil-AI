# Never commit a real API key. Copy this file to .env and fill it locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local development may use SQLite. Production uses pooled runtime traffic and
# a direct connection for migrations; never expose either URL to the frontend.
MEDVIGIL_ENV=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
MEDVIGIL_DB_PATH=backend/medvigil.db
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
